// ============================================================
// ÉLISE — Content.js
// The content library: Themes, DefaultCalendar, Keywords and Entries tabs of
// the Elise Sheet, how a row maps to an entry, and the validator.
//
// Everything above the "Sheet wrappers" line is pure (no Apps Script
// services), so tests/content.test.js runs it with Node.
// ============================================================

var CATEGORIES_ = ['travel', 'social', 'errands', 'work', 'daily', 'seasonal'];

var CONTENT_TABS_ = {
  Themes: ['tag', 'category', 'name_fr', 'name_en', 'related'],
  DefaultCalendar: ['week', 'tag'],
  Keywords: ['keyword', 'target'],
  Entries: ['id', 'theme', 'level', 'word', 'pos', 'fem', 'ipa', 'def_fr', 'def_en', 'example_fr', 'example_en',
            'phrase_fr', 'phrase_en', 'register', 'register_note',
            'd1_fr', 'd1_en', 'd2_fr', 'd2_en', 'd3_fr', 'd3_en', 'd4_fr', 'd4_en', 'tts'],
  Idioms: ['id', 'theme', 'idiom_fr', 'literal', 'meaning_en', 'example_fr', 'example_en']
};

var ENTRY_REQUIRED_ = ['id', 'theme', 'level', 'word', 'pos', 'ipa', 'def_fr', 'def_en', 'example_fr', 'example_en',
                       'phrase_fr', 'phrase_en', 'register', 'register_note'];

var IDIOM_REQUIRED_ = ['id', 'theme', 'fr', 'literal', 'en', 'example_fr', 'example_en'];

// Six idioms per theme: one for each of Mon–Sat. A repeat year reuses them.
var IDIOMS_PER_THEME_ = 6;

var ENTRIES_PER_THEME_ = { min: 10, max: 14 };

// Each week: 4 B1, 1 B2 ("Niveau +") and 1 argot, shuffled over Mon–Sat; Sunday
// reviews them. A theme needs at least this many of each so a repeat year
// still has unseen ones.
var LEVELS_ = ['B1', 'B2', 'argot'];
var LEVEL_MIN_PER_THEME_ = { B1: 6, B2: 2, argot: 2 };

// ---- Rows <-> objects (pure) ------------------------------------------------

/** Pure: entry object → Entries row. Dialogue speakers alternate A, B, A, B. */
function entryToRow_(e) {
  var d = e.dialogue || [];
  var row = [e.id, e.theme, e.level, e.word, e.pos, e.fem || '', e.ipa, e.def_fr, e.def_en, e.example_fr, e.example_en,
             e.phrase_fr, e.phrase_en, e.register, e.register_note];
  for (var i = 0; i < 4; i++) row.push(d[i] ? d[i].fr : '', d[i] ? d[i].en : '');
  row.push(e.tts || '');
  return row;
}

/** Pure: Entries row → entry object (the shape the app uses). */
function rowToEntry_(r) {
  var s = function (v) { return v == null ? '' : String(v).trim(); };
  var dialogue = [];
  for (var i = 0; i < 4; i++) {
    var fr = s(r[15 + i * 2]), en = s(r[16 + i * 2]);
    if (fr || en) dialogue.push({ who: i % 2 ? 'B' : 'A', fr: fr, en: en });
  }
  return {
    id: s(r[0]), theme: s(r[1]), level: s(r[2]), word: s(r[3]), pos: s(r[4]), fem: s(r[5]) || null, ipa: s(r[6]),
    def_fr: s(r[7]), def_en: s(r[8]), example_fr: s(r[9]), example_en: s(r[10]),
    phrase_fr: s(r[11]), phrase_en: s(r[12]), register: s(r[13]), register_note: s(r[14]),
    dialogue: dialogue, tts: s(r[23]) || null
  };
}

/** Pure: idiom object <-> Idioms row. */
function idiomToRow_(i) { return [i.id, i.theme, i.fr, i.literal, i.en, i.example_fr, i.example_en]; }

function rowToIdiom_(r) {
  var s = function (v) { return v == null ? '' : String(v).trim(); };
  return { id: s(r[0]), theme: s(r[1]), fr: s(r[2]), literal: s(r[3]), en: s(r[4]), example_fr: s(r[5]), example_en: s(r[6]) };
}

function themeToRow_(t) { return [t.tag, t.category, t.name_fr, t.name_en, (t.related || []).join(', ')]; }

function rowToTheme_(r) {
  return {
    tag: String(r[0]).trim(), category: String(r[1]).trim(), name_fr: String(r[2]).trim(), name_en: String(r[3]).trim(),
    related: String(r[4] || '').split(',').map(function (x) { return x.trim(); }).filter(Boolean)
  };
}

// ---- Validation (pure) ------------------------------------------------------

/** Pure: the word without its article, lower case ("l'ordre du jour" → "ordre du jour"). */
function lemma_(word) {
  return String(word || '').toLowerCase().trim()
    .replace(/^(le|la|les|un|une|des|se)\s+/, '')
    .replace(/^(l|s|d)['’]\s*/, '');
}

function norm_(s) { return String(s || '').toLowerCase().replace(/[’]/g, "'").replace(/\s+/g, ' ').trim(); }

/**
 * Pure: checks the library against the content rules.
 *   lib = { themes: [...], calendar: {week: tag}, keywords: [[kw, target]], entries: [...], idioms: [...] }
 *   opts.complete: also require 10–14 entries for every theme (false while the
 *                  library is being written).
 * Returns { errors: [string], warnings: [string], counts: {tag: n} }.
 */
function validateLibrary_(lib, opts) {
  opts = opts || {};
  var errors = [], warnings = [];
  var tags = {};

  (lib.themes || []).forEach(function (t, i) {
    var where = 'Themes row ' + (i + 2) + ' (' + t.tag + ')';
    if (!/^[a-z]+\.[a-z_]+$/.test(t.tag)) errors.push(where + ': tag must look like category.name');
    if (tags[t.tag]) errors.push(where + ': duplicate tag');
    tags[t.tag] = t;
    if (CATEGORIES_.indexOf(t.category) === -1) errors.push(where + ': unknown category ' + t.category);
    if (t.tag.split('.')[0] !== t.category) errors.push(where + ': tag prefix does not match category');
    if (!t.name_fr || !t.name_en) errors.push(where + ': missing name');
    if (!t.related || !t.related.length) errors.push(where + ': needs at least one related tag');
  });
  (lib.themes || []).forEach(function (t) {
    (t.related || []).forEach(function (r) {
      if (r === t.tag) errors.push('Themes ' + t.tag + ': related to itself');
      else if (!tags[r]) errors.push('Themes ' + t.tag + ': related tag ' + r + ' does not exist');
    });
  });

  for (var w = 1; w <= 53; w++) {
    var tag = lib.calendar && lib.calendar[w];
    if (!tag) errors.push('DefaultCalendar: week ' + w + ' is missing');
    else if (!tags[tag]) errors.push('DefaultCalendar: week ' + w + ' uses unknown tag ' + tag);
  }

  var seenKw = {};
  (lib.keywords || []).forEach(function (k) {
    var kw = norm_(k[0]), target = k[1];
    if (!kw) return;
    if (seenKw[kw]) errors.push('Keywords: "' + kw + '" is listed twice');
    seenKw[kw] = true;
    if (!tags[target] && CATEGORIES_.indexOf(target) === -1) errors.push('Keywords: "' + kw + '" points to unknown ' + target);
  });

  var ids = {}, words = {}, counts = {}, levels = {};
  Object.keys(tags).forEach(function (t) { counts[t] = 0; levels[t] = { B1: 0, B2: 0, argot: 0 }; });
  (lib.entries || []).forEach(function (e, i) {
    var where = 'Entries row ' + (i + 2) + ' (' + (e.id || '?') + ')';
    ENTRY_REQUIRED_.forEach(function (f) { if (!e[f]) errors.push(where + ': missing ' + f); });
    if (!tags[e.theme]) { errors.push(where + ': unknown theme ' + e.theme); return; }
    counts[e.theme]++;
    if (LEVELS_.indexOf(e.level) === -1) errors.push(where + ': level must be B1, B2 or argot');
    else levels[e.theme][e.level]++;
    if (ids[e.id]) errors.push(where + ': duplicate id');
    ids[e.id] = true;
    if (e.id && e.id.indexOf(e.theme + '.') !== 0) errors.push(where + ': id must start with its theme');

    var l = lemma_(e.word);
    if (words[l]) errors.push(where + ': word "' + e.word + '" already used by ' + words[l]);
    words[l] = e.id;


    if (!e.dialogue || e.dialogue.length !== 4 || e.dialogue.some(function (d) { return !d.fr || !d.en; })) {
      errors.push(where + ': needs 4 dialogue lines, each in French and English');
    } else {
      // The phrase may run on inside the line ("…de froid, surtout à gauche"),
      // so its final punctuation is not part of the match.
      var p = norm_(e.phrase_fr).replace(/[\s.!?…]+$/, '');
      if (norm_(e.dialogue[0].fr).indexOf(p) === -1 && norm_(e.dialogue[1].fr).indexOf(p) === -1) {
        errors.push(where + ': the phrase must appear in dialogue line 1 or 2');
      }
    }
    if (!/^(tu|vous)\b/.test(String(e.register || ''))) errors.push(where + ': register must start with "tu" or "vous"');

    var ex = norm_(e.example_fr);
    if (ex.indexOf(l) === -1 && !(e.fem && ex.indexOf(lemma_(e.fem)) !== -1)) {
      warnings.push(where + ': the word does not appear as-is in its example');
    }
    if (e.ipa && !/^\/.+\/$/.test(e.ipa)) warnings.push(where + ': IPA should be written between slashes');
  });

  var idiomIds = {}, idiomText = {}, idiomCounts = {};
  Object.keys(tags).forEach(function (t) { idiomCounts[t] = 0; });
  (lib.idioms || []).forEach(function (m, i) {
    var where = 'Idioms row ' + (i + 2) + ' (' + (m.id || '?') + ')';
    IDIOM_REQUIRED_.forEach(function (f) { if (!m[f]) errors.push(where + ': missing ' + f); });
    if (!tags[m.theme]) { errors.push(where + ': unknown theme ' + m.theme); return; }
    idiomCounts[m.theme]++;
    if (idiomIds[m.id]) errors.push(where + ': duplicate id');
    idiomIds[m.id] = true;
    if (m.id && m.id.indexOf(m.theme + '.i') !== 0) errors.push(where + ': id must look like ' + m.theme + '.i01');
    var k = norm_(m.fr);
    if (idiomText[k]) errors.push(where + ': idiom "' + m.fr + '" already used by ' + idiomText[k]);
    idiomText[k] = m.id;
  });
  Object.keys(idiomCounts).forEach(function (t) {
    var n = idiomCounts[t];
    if (n > IDIOMS_PER_THEME_) errors.push('Theme ' + t + ': ' + n + ' idioms (max ' + IDIOMS_PER_THEME_ + ')');
    else if (opts.complete && n < IDIOMS_PER_THEME_) errors.push('Theme ' + t + ': ' + n + ' idioms (need ' + IDIOMS_PER_THEME_ + ')');
  });

  Object.keys(counts).forEach(function (t) {
    var n = counts[t];
    if (n > ENTRIES_PER_THEME_.max) errors.push('Theme ' + t + ': ' + n + ' entries (max ' + ENTRIES_PER_THEME_.max + ')');
    else if (opts.complete && n < ENTRIES_PER_THEME_.min) errors.push('Theme ' + t + ': ' + n + ' entries (min ' + ENTRIES_PER_THEME_.min + ')');
    if (opts.complete) {
      LEVELS_.forEach(function (lv) {
        if (levels[t][lv] < LEVEL_MIN_PER_THEME_[lv]) {
          errors.push('Theme ' + t + ': ' + levels[t][lv] + ' ' + lv + ' entries (min ' + LEVEL_MIN_PER_THEME_[lv] + ')');
        }
      });
    }
  });

  return { errors: errors, warnings: warnings, counts: counts, levels: levels, idioms: idiomCounts };
}

// ---- Sheet wrappers (Apps Script only) -------------------------------------

/** Reads the whole library from the Elise Sheet. */
function readLibrary_() {
  var rows = function (name) {
    var sh = ss_().getSheetByName(name);
    return sh ? sh.getDataRange().getValues().slice(1).filter(function (r) { return String(r[0]).trim(); }) : [];
  };
  var calendar = {};
  rows('DefaultCalendar').forEach(function (r) { calendar[Number(r[0])] = String(r[1]).trim(); });
  return {
    themes: rows('Themes').map(rowToTheme_),
    calendar: calendar,
    keywords: rows('Keywords').map(function (r) { return [String(r[0]), String(r[1]).trim()]; }),
    entries: rows('Entries').map(rowToEntry_),
    idioms: rows('Idioms').map(rowToIdiom_)
  };
}

/**
 * Run from the editor: checks the library in the Sheet and logs the result.
 * validateContent(true) also requires 10–14 entries for every theme.
 */
function validateContent(complete) {
  var res = validateLibrary_(readLibrary_(), { complete: complete === true });
  Logger.log(res.errors.length + ' error(s), ' + res.warnings.length + ' warning(s)');
  res.errors.forEach(function (m) { Logger.log('ERROR   ' + m); });
  res.warnings.forEach(function (m) { Logger.log('warning ' + m); });
  return res;
}

// ---- Import from the repo (Apps Script only) -------------------------------

var CONTENT_BASE_URL_ = 'https://raw.githubusercontent.com/aeraky1565/my-language-app/main/content/library/';

/**
 * Run from the editor: adds entries and idioms from the repo's content/library
 * whose id is not already in the Sheet. Never changes or deletes an existing
 * row, so edits made by hand in the Sheet are kept. Then validates the library.
 */
function importNewContent() {
  var index = JSON.parse(UrlFetchApp.fetch(CONTENT_BASE_URL_ + 'INDEX.json').getContentText());
  var added = { Entries: 0, Idioms: 0 };
  var existing = function (tab) {
    var ids = {};
    sheet_(tab).getDataRange().getValues().slice(1).forEach(function (r) { if (r[0]) ids[String(r[0]).trim()] = true; });
    return ids;
  };
  var have = { Entries: existing('Entries'), Idioms: existing('Idioms') };
  var rows = { Entries: [], Idioms: [] };
  index.files.forEach(function (f) {
    var lib = JSON.parse(UrlFetchApp.fetch(CONTENT_BASE_URL_ + encodeURIComponent(f)).getContentText());
    (lib.entries || []).forEach(function (e) { if (!have.Entries[e.id]) rows.Entries.push(entryToRow_(e)); });
    (lib.idioms || []).forEach(function (i) { if (!have.Idioms[i.id]) rows.Idioms.push(idiomToRow_(i)); });
  });
  ['Entries', 'Idioms'].forEach(function (tab) {
    if (!rows[tab].length) return;
    var sh = sheet_(tab);
    sh.getRange(sh.getLastRow() + 1, 1, rows[tab].length, rows[tab][0].length).setNumberFormat('@').setValues(rows[tab]);
    added[tab] = rows[tab].length;
  });
  Logger.log('Added ' + added.Entries + ' entries and ' + added.Idioms + ' idioms.');
  return validateContent();
}

// ======================= Engine.js =======================
// ============================================================
// ÉLISE — Engine.js
// The theme engine: which theme a week gets, and which entries and idioms
// each day of that week shows.
//
// Everything above the "Apps Script wrappers" line is pure (no Apps Script
// services) and covered by tests/engine.test.js.
//
// THE RULES (docs/SPEC.md §5, with the changes recorded there):
//  1. Calendar first. Events in the week AFTER the theme week (Monday+7 to
//     Sunday+13) are matched against the Keywords tab, so you practise the week
//     before the event. Skipped: recurring events, declined events, and all-day
//     birthday-style reminders (multi-day all-day events such as a trip count).
//     A keyword that names a theme beats one that names a category. Between
//     events: travel > social > errands > work > daily > seasonal, then the
//     earliest date. An event whose theme is on cooldown tries that theme's
//     related themes; if none is free, the next event is tried.
//  2. Otherwise the default calendar: the theme for the week's ISO week. In
//     even ISO years every non-seasonal default is swapped for its first related
//     theme. A default on cooldown falls back to its related themes, then to the
//     least recently used free theme.
//  3. Cooldown: a theme used in any of the previous 8 weeks is not picked.
//  4. Only themes whose content is complete can be picked (while the library is
//     being written).
//  5. Locked: once a week has a theme it keeps it, unless the run is forced
//     (Réglages › Recalculer).
//  6. The week's plan: Mon–Sat show 4 B1, 1 B2 and 1 argot entry, shuffled with
//     a seed from the week, so every run agrees; Sunday reviews them. Unseen
//     entries first, then the ones seen longest ago. Six idioms the same way.
// ============================================================

var CATEGORY_ORDER_ = ['travel', 'social', 'errands', 'work', 'daily', 'seasonal'];
var COOLDOWN_WEEKS_ = 8;
var MOIS_ = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
var BIRTHDAY_RE_ = /\b(birthday|bday|b-day|anniversaire)\b/;

// ---- Dates (pure) -----------------------------------------------------------

function enParse_(ymd) { var p = String(ymd).split('-').map(Number); return Date.UTC(p[0], p[1] - 1, p[2]); }
function enYmd_(ms) { return new Date(ms).toISOString().slice(0, 10); }
function enShift_(ymd, n) { return enYmd_(enParse_(ymd) + n * 864e5); }
/** Pure: Monday = 0 … Sunday = 6. */
function enDow_(ymd) { return (new Date(enParse_(ymd)).getUTCDay() + 6) % 7; }
function enMonday_(ymd) { return enShift_(ymd, -enDow_(ymd)); }

/** Pure: ISO 8601 week of a date → { year, week }. The week belongs to the year of its Thursday. */
function isoWeek_(ymd) {
  var thursday = enShift_(ymd, 3 - enDow_(ymd));
  var year = Number(thursday.slice(0, 4));
  var week = Math.floor((enParse_(thursday) - Date.UTC(year, 0, 1)) / 864e5 / 7) + 1;
  return { year: year, week: week };
}

function frDate_(ymd) {
  var p = String(ymd).split('-').map(Number);
  return p[2] + (p[2] === 1 ? 'er' : '') + ' ' + MOIS_[p[1] - 1];
}

// ---- Keyword matching (pure) -------------------------------------------------

/** Pure: lower case, no accents, curly quotes straightened. */
function enNorm_(s) {
  return String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[’`]/g, "'");
}

/** Pure: a regex that finds the keyword as whole word(s), plural "s" allowed. */
function keywordRegex_(kw) {
  var k = enNorm_(kw).trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/\s+/g, '\\s+');
  var tail = /[a-z]$/.test(enNorm_(kw).trim()) ? 's?' : '';
  return new RegExp('(^|[^a-z0-9])' + k + tail + '(?=$|[^a-z0-9])');
}

/** Pure: should this event be ignored? */
function skipEvent_(e) {
  if (e.recurring || e.declined) return true;
  if (e.allDay && (!e.end || e.end <= enShift_(e.start, 1))) {   // a single all-day day
    if (BIRTHDAY_RE_.test(enNorm_(e.title)) || /#contacts@/.test(String(e.calendarId || ''))) return true;
  }
  return false;
}

/**
 * Pure: the best keyword hit for one event → { target, category, keyword } or null.
 * A keyword naming a theme beats one naming a category; then category order; then
 * the keyword that comes first in the title ("Birthday dinner" is a birthday);
 * then the order of the Keywords tab.
 */
function matchEvent_(e, keywords, themesByTag) {
  var text = enNorm_(e.title + ' ' + (e.location || ''));
  var best = null;
  keywords.forEach(function (k, i) {
    var kw = k[0], target = k[1];
    var hit = kw ? keywordRegex_(kw).exec(text) : null;
    if (!hit) return;
    var isTag = !!themesByTag[target];
    var category = isTag ? themesByTag[target].category : target;
    var rank = [isTag ? 0 : 1, CATEGORY_ORDER_.indexOf(category), hit.index, i];
    var better = !best;
    for (var r = 0; !better && r < rank.length && rank[r] <= best.rank[r]; r++) better = rank[r] < best.rank[r];
    if (better) best = { target: target, category: category, keyword: kw, rank: rank };
  });
  return best;
}

/**
 * Pure: matching events in the detection window of the week starting weekStart,
 * best first → [{ target, category, keyword, title, date }].
 */
function calendarCandidates_(events, lib, weekStart) {
  var from = enShift_(weekStart, 7), to = enShift_(weekStart, 13);
  var byTag = themesByTag_(lib.themes);
  var out = [];
  (events || []).forEach(function (e) {
    if (!e || !e.start || e.start < from || e.start > to || skipEvent_(e)) return;
    var m = matchEvent_(e, lib.keywords || [], byTag);
    if (m) out.push({ target: m.target, category: m.category, keyword: m.keyword, title: e.title, date: e.start });
  });
  out.sort(function (a, b) {
    var c = CATEGORY_ORDER_.indexOf(a.category) - CATEGORY_ORDER_.indexOf(b.category);
    return c || (a.date < b.date ? -1 : a.date > b.date ? 1 : 0);
  });
  return out;
}

// ---- Choosing the theme (pure) ------------------------------------------------

function themesByTag_(themes) {
  var m = {};
  (themes || []).forEach(function (t) { m[t.tag] = t; });
  return m;
}

/** Pure: themes used in the COOLDOWN_WEEKS_ weeks before weekStart. */
function cooledTags_(history, weekStart) {
  var from = enShift_(weekStart, -7 * COOLDOWN_WEEKS_), set = {};
  (history || []).forEach(function (h) { if (h.week_start >= from && h.week_start < weekStart) set[h.tag] = true; });
  return set;
}

/** Pure: a theme tag, or a category, → a free theme tag (itself, then its related themes), or null. */
function resolveTarget_(target, lib, ok) {
  var byTag = themesByTag_(lib.themes);
  if (byTag[target]) {
    if (ok(target)) return target;
    var rel = (byTag[target].related || []).filter(ok);
    return rel.length ? rel[0] : null;
  }
  var inCat = (lib.themes || []).filter(function (t) { return t.category === target && ok(t.tag); });
  return inCat.length ? inCat[0].tag : null;
}

/** Pure: the default-calendar theme for the week → { tag, swapped, week }. */
function defaultTheme_(lib, weekStart, ok, history, avail) {
  var iw = isoWeek_(weekStart), byTag = themesByTag_(lib.themes);
  var base = lib.calendar[iw.week] || lib.calendar[String(iw.week)] || lib.calendar[52] || lib.calendar['52'];
  var t = byTag[base];
  var swap = iw.year % 2 === 0 && t && t.category !== 'seasonal' && t.related && t.related.length;
  var order = [];
  if (swap) order.push(t.related[0]);
  order.push(base);
  ((t && t.related) || []).forEach(function (r) { if (order.indexOf(r) === -1) order.push(r); });
  for (var i = 0; i < order.length; i++) {
    if (byTag[order[i]] && ok(order[i])) return { tag: order[i], swapped: i === 0 && !!swap, week: iw.week };
  }
  // Everything near the default is taken: the free theme used longest ago.
  var lastUsed = {};
  (history || []).forEach(function (h) { if (!lastUsed[h.tag] || h.week_start > lastUsed[h.tag]) lastUsed[h.tag] = h.week_start; });
  var byAge = function (a, b) { var x = String(lastUsed[a.tag] || ''), y = String(lastUsed[b.tag] || ''); return x < y ? -1 : x > y ? 1 : 0; };
  var free = (lib.themes || []).filter(function (x) { return ok(x.tag); }).sort(byAge);
  if (free.length) return { tag: free[0].tag, swapped: false, week: iw.week };
  // Every usable theme is on cooldown (a small library): relax the cooldown, but
  // never pick a theme that has no content.
  var usable = (lib.themes || []).filter(function (x) { return !avail || avail(x.tag); }).sort(byAge);
  return { tag: usable.length ? usable[0].tag : base, swapped: false, week: iw.week };
}

/**
 * Pure: the theme for the week starting weekStart (a Monday).
 *   input = { weekStart, events, lib: {themes, calendar, keywords}, history: [{week_start, tag, …}],
 *             available: [tags] or null (= every theme), force }
 * → { week_start, tag, source: 'calendar'|'default'|'locked', why, event_date }
 */
function chooseTheme_(input) {
  var weekStart = input.weekStart, lib = input.lib, history = input.history || [];
  var existing = history.filter(function (h) { return h.week_start === weekStart; })[0];
  if (existing && !input.force) {
    return { week_start: weekStart, tag: existing.tag, source: 'locked', why: existing.why || '', event_date: existing.event_date || '' };
  }
  var past = history.filter(function (h) { return h.week_start !== weekStart; });
  var cooled = cooledTags_(past, weekStart);
  var avail = null;
  if (input.available) { avail = {}; input.available.forEach(function (t) { avail[t] = true; }); }
  var ok = function (tag) { return !cooled[tag] && (!avail || avail[tag]); };

  var cands = calendarCandidates_(input.events, lib, weekStart);
  for (var i = 0; i < cands.length; i++) {
    var tag = resolveTarget_(cands[i].target, lib, ok);
    if (tag) {
      return { week_start: weekStart, tag: tag, source: 'calendar',
               why: '« ' + cands[i].title + ' » le ' + frDate_(cands[i].date), event_date: cands[i].date };
    }
  }
  var d = defaultTheme_(lib, weekStart, ok, past, avail ? function (t) { return !!avail[t]; } : null);
  return { week_start: weekStart, tag: d.tag, source: 'default',
           why: 'Calendrier par défaut · semaine ' + d.week, event_date: '' };
}

// ---- Which themes are complete (pure) -------------------------------------------

/**
 * Pure: tags with enough content to run two weeks at `level` (default B1): 10+ entries with the
 * level's minimum per kind (B1 mode: 6 B1, 2 B2, 2 argot; B2 mode: 4 B1, 6 B2, 2 argot) and 6 idioms.
 */
function completeTags_(lib, level) {
  var res = validateLibrary_(lib, {}), need = requiredFor_(level);
  return (lib.themes || []).map(function (t) { return t.tag; }).filter(function (t) {
    if ((res.counts[t] || 0) < ENTRIES_PER_THEME_.min || (res.idioms[t] || 0) < IDIOMS_PER_THEME_) return false;
    return Object.keys(need).every(function (lv) { return (res.levels[t][lv] || 0) >= need[lv]; });
  });
}

// ---- The week's plan (pure) -----------------------------------------------------

/** Pure: a 32-bit hash of a string (FNV-1a). */
function enHash_(s) {
  var h = 2166136261;
  for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
  return h >>> 0;
}

/** Pure: a copy of list shuffled by a seeded generator (mulberry32). */
function seededShuffle_(list, seed) {
  var a = list.slice(), s = seed >>> 0;
  var rnd = function () {
    s = (s + 0x6D2B79F5) >>> 0;
    var t = s;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(rnd() * (i + 1)); var x = a[i]; a[i] = a[j]; a[j] = x; }
  return a;
}

/** Pure: n items, never-shown first (in id order), then the ones shown longest ago. */
function pickFresh_(items, shown, n) {
  var unseen = items.filter(function (x) { return !shown[x.id]; }).sort(function (a, b) { return a.id < b.id ? -1 : 1; });
  var seen = items.filter(function (x) { return shown[x.id]; }).sort(function (a, b) {
    var la = shown[a.id].last_shown || '', lb = shown[b.id].last_shown || '';
    return la < lb ? -1 : la > lb ? 1 : (a.id < b.id ? -1 : 1);
  });
  return unseen.concat(seen).slice(0, n);
}

/**
 * Pure: the plan for a theme week.
 *   input = { weekStart, tag, entries: [entries of the theme], idioms: [idioms of the theme],
 *             shown: { id: { last_shown, times_shown } }, level: 'B1'|'B2' (the weekly mix; default B1) }
 * → { days: [{ day: 0..5, entry_id, level, idiom_id }], review: [entry ids] }   (day 0 = Monday; Sunday is the review)
 */
function planWeek_(input) {
  var shown = input.shown || {}, entries = input.entries || [], chosen = [], used = {};
  mixFor_(input.level).forEach(function (mix) {
    pickFresh_(entries.filter(function (e) { return e.level === mix[0]; }), shown, mix[1])
      .forEach(function (e) { chosen.push(e); used[e.id] = true; });
  });
  if (chosen.length < 6) {   // a level ran short: top up from whatever is left
    pickFresh_(entries.filter(function (e) { return !used[e.id]; }), shown, 6 - chosen.length).forEach(function (e) { chosen.push(e); });
  }
  var order = seededShuffle_(chosen, enHash_(input.weekStart + '|' + input.tag));
  var idioms = seededShuffle_(pickFresh_(input.idioms || [], shown, 6), enHash_(input.weekStart + '|' + input.tag + '|idioms'));
  return {
    days: order.map(function (e, i) { return { day: i, entry_id: e.id, level: e.level, idiom_id: idioms[i] ? idioms[i].id : '' }; }),
    review: order.map(function (e) { return e.id; })
  };
}

// ---- Apps Script wrappers ----------------------------------------------------------

var ENGINE_TABS_ = {
  ThemeWeeks: ['week_start', 'tag', 'source', 'why', 'event_date', 'plan', 'chosen_at'],
  Shown: ['id', 'kind', 'theme', 'first_shown', 'last_shown', 'times_shown', 'box', 'due', 'last_rating', 'last_review', 'reviews', 'knew']
};

function todayYmd_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd'); }

/** Your calendars' events between two days, in the shape the engine reads. Never writes. */
function readEvents_(fromYmd, toYmd) {
  var excluded = config_().excluded_calendars;
  var tzz = tz_(), start = new Date(fromYmd + 'T00:00:00'), end = new Date(enShift_(toYmd, 1) + 'T00:00:00');
  var out = [];
  CalendarApp.getAllCalendars().forEach(function (cal) {
    if (excluded.indexOf(cal.getId()) !== -1 || cal.getName() === ELISE_CALENDAR_NAME_) return;
    cal.getEvents(start, end).forEach(function (ev) {
      var allDay = ev.isAllDayEvent();
      var s = allDay ? ev.getAllDayStartDate() : ev.getStartTime();
      var e = allDay ? ev.getAllDayEndDate() : ev.getEndTime();
      var status = '';
      try { status = String(ev.getMyStatus()); } catch (x) {}
      out.push({
        title: ev.getTitle(), location: ev.getLocation(), allDay: allDay,
        start: Utilities.formatDate(s, tzz, 'yyyy-MM-dd'), end: Utilities.formatDate(e, tzz, 'yyyy-MM-dd'),
        recurring: ev.isRecurringEvent(), declined: status === 'NO', calendarId: cal.getId()
      });
    });
  });
  return out;
}

function readThemeWeeks_() {
  return sheet_('ThemeWeeks').getDataRange().getValues().slice(1).filter(function (r) { return r[0]; }).map(function (r) {
    return { week_start: cellDate_(r[0]), tag: String(r[1]), source: String(r[2]), why: String(r[3]),
             event_date: r[4] ? cellDate_(r[4]) : '', plan: r[5] ? JSON.parse(r[5]) : null };
  });
}

function readShown_() {
  var m = {};
  sheet_('Shown').getDataRange().getValues().slice(1).forEach(function (r) {
    if (r[0]) m[String(r[0])] = { kind: String(r[1]), last_shown: cellDate_(r[4]), times_shown: Number(r[5]) || 0,
                                  box: Number(r[6]) || 0, due: r[7] ? cellDate_(r[7]) : '' };
  });
  return m;
}

/** Chooses (or re-chooses, when forced) the theme and plan for a week, and stores them in ThemeWeeks. */
function weekFor_(weekStart, force) {
  var history = readThemeWeeks_();
  var existing = history.filter(function (h) { return h.week_start === weekStart; })[0];
  if (existing && !force) return existing;
  var lib = readLibrary_();
  // The weekly mix follows Config › level; a level without enough content yet falls back to B1.
  var level = config_().level, available = completeTags_(lib, level);
  if (!available.length && level !== 'B1') { level = 'B1'; available = completeTags_(lib, 'B1'); }
  var choice = chooseTheme_({
    weekStart: weekStart, lib: lib, history: history, force: !!force,
    available: available, events: readEvents_(enShift_(weekStart, 7), enShift_(weekStart, 13))
  });
  var plan = planWeek_({
    weekStart: weekStart, tag: choice.tag, shown: readShown_(), level: level,
    entries: lib.entries.filter(function (e) { return e.theme === choice.tag; }),
    idioms: lib.idioms.filter(function (i) { return i.theme === choice.tag; })
  });
  var row = [weekStart, choice.tag, choice.source, choice.why, choice.event_date, JSON.stringify(plan), nowStamp_()];
  var sh = sheet_('ThemeWeeks'), at = findRow_(sh, weekStart);
  writeRow_(sh, at, row);
  Logger.log('Week of ' + weekStart + ': ' + choice.tag + ' (' + choice.source + ': ' + choice.why + ')');
  return { week_start: weekStart, tag: choice.tag, source: choice.source, why: choice.why, event_date: choice.event_date, plan: plan };
}

/** Trigger, Sundays at 21:00: chooses next week's theme. */
function chooseNextWeek() {
  try { updateReadiness_(); } catch (e) { Logger.log('updateReadiness_: ' + e); }
  return weekFor_(enShift_(enMonday_(todayYmd_()), 7), false);
}

/** The current week's theme, chosen now if it has none yet (first launch). */
function currentWeek_() { return weekFor_(enMonday_(todayYmd_()), false); }

/** Réglages › Recalculer: re-chooses this week's theme, ignoring the lock. */
function rerunThisWeek() { return weekFor_(enMonday_(todayYmd_()), true); }

/** Run once from the editor: the Sunday 21:00 trigger (replaces an earlier one). */
function installTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'chooseNextWeek') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('chooseNextWeek').timeBased().onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(21).create();
  Logger.log('Trigger set: chooseNextWeek, Sundays at 21:00 (' + Session.getScriptTimeZone() + ').');
}

// ======================= Today.js =======================
// ============================================================
// ÉLISE — Today.js
// What the Today screen shows each day, and the two logs it keeps:
//   Shown     every entry and idiom you've seen: first and last day, how many
//             days (unseen-first picking now, spaced repetition later).
//   Practice  one row per FINISHED day (word and idiom played, phrase and
//             dialogue heard, one line spoken): minutes, sessions, new items,
//             reviewed, theme, note. The streak and week dots come from here.
//             VERA reads this tab (docs/vera/ISSUE.md); ÉLISE never calls VERA.
//
// Everything above the "Apps Script" line is pure and covered by
// tests/today.test.js.
// ============================================================

var PRACTICE_COLS_ = ['date', 'language', 'minutes', 'sessions', 'new_items', 'reviewed', 'theme', 'note', 'updated_at', 'speaking'];

// ---- pure --------------------------------------------------------------------

/**
 * Pure: the day's content from the week's plan.
 *   o = { date, week: { tag, why, source, plan }, lib: { themes, entries, idioms }, nextTag }
 *   o.due = [ids due for spaced review] (Sunday only; entries and idioms from past weeks)
 * → { mode: 'day', todayIndex, theme, entry, idiom }            Monday to Saturday
 *   { mode: 'review', todayIndex: 6, theme, review: { entries, idioms } }   Sunday: the week's six of
 *   each, then the due ones from past weeks (marked due: true)
 */
function buildToday_(o) {
  var byTag = themesByTag_(o.lib.themes), t = byTag[o.week.tag] || { tag: o.week.tag, name_fr: o.week.tag };
  var E = {}, I = {};
  (o.lib.entries || []).forEach(function (e) { E[e.id] = e; });
  (o.lib.idioms || []).forEach(function (i) { I[i.id] = i; });
  var plan = o.week.plan || { days: [], review: [] };
  var theme = {
    tag: t.tag, name_fr: t.name_fr, name_en: t.name_en, why: o.week.why || '', source: o.week.source || '',
    next_name_fr: o.nextTag && byTag[o.nextTag] ? byTag[o.nextTag].name_fr : ''
  };
  var dow = enDow_(o.date);
  if (dow === 6) {
    return {
      mode: 'review', todayIndex: 6, theme: theme,
      review: {
        entries: (plan.review || []).map(function (id) { return E[id]; }).filter(Boolean)
          .concat((o.due || []).filter(function (id) { return E[id]; }).map(function (id) { return Object.assign({ due: true }, E[id]); })),
        idioms: (plan.days || []).map(function (d) { return I[d.idiom_id]; }).filter(Boolean)
          .concat((o.due || []).filter(function (id) { return I[id]; }).map(function (id) { return Object.assign({ due: true }, I[id]); }))
      }
    };
  }
  var d = (plan.days || [])[dow] || (plan.days || [])[(plan.days || []).length - 1];
  return { mode: 'day', todayIndex: dow, theme: theme, entry: d ? E[d.entry_id] || null : null, idiom: d ? I[d.idiom_id] || null : null };
}

/**
 * Pure: a Shown row after seeing an item on `date`.
 *   prev = [id, kind, theme, first_shown, last_shown, times_shown] or null
 * → { row, isNew, changed }   (a second view the same day changes nothing)
 */
function shownRow_(prev, item, date) {
  if (!prev) return { row: [item.id, item.kind, item.theme, date, date, 1], isNew: true, changed: true };
  if (String(prev[4]) === date) return { row: prev, isNew: false, changed: false };
  return { row: [prev[0], prev[1], prev[2], prev[3], date, (Number(prev[5]) || 0) + 1], isNew: false, changed: true };
}

/** Pure: the day's Practice record with a patch added (minutes and sessions add up; new items and reviewed keep the highest). */
function mergePractice_(prev, patch, date, language, now) {
  var p = prev || {};
  var n = function (v) { return Number(v) || 0; };
  return {
    date: date, language: p.language || language,
    minutes: n(p.minutes) + n(patch.minutes), sessions: n(p.sessions) + n(patch.sessions),
    new_items: Math.max(n(p.new_items), n(patch.new_items)), reviewed: Math.max(n(p.reviewed), n(patch.reviewed)),
    theme: patch.theme || p.theme || '', note: patch.note || p.note || '', updated_at: now,
    speaking: patch.speaking !== undefined && patch.speaking !== '' ? patch.speaking : (p.speaking == null ? '' : p.speaking)
  };
}

/** Pure: minutes reported by the app → a sane whole number (0–120). */
function sessionMinutes_(raw) {
  var m = Math.round(Number(raw) || 0);
  return Math.max(0, Math.min(120, m));
}

// ---- Apps Script -----------------------------------------------------------------

/** The Today payload: the engine's day (or the built-in sample until the library is in the Sheet). */
function todayPayload_() {
  var today = recordVisit_(), saved = savedIndex_(), cfg = config_();
  var body = null;
  var lib = readLibrary_();
  if (completeTags_(lib).length) {
    var week = currentWeek_();
    var next = readThemeWeeks_().filter(function (h) { return h.week_start === enShift_(enMonday_(today), 7); })[0];
    var due = [];
    if (enDow_(today) === 6) {
      var mine = {};
      ((week.plan && week.plan.days) || []).forEach(function (d) { mine[d.entry_id] = true; mine[d.idiom_id] = true; });
      due = dueItems_(readShown_(), today, mine, REVIEW_DUE_LIMIT_);
    }
    body = buildToday_({ date: today, week: week, lib: lib, nextTag: next && next.tag, due: due });
    if (body.mode === 'day' && !body.entry) body = null;
  }
  if (!body) {
    body = { mode: 'day', todayIndex: weekdayIndex_(today), theme: SAMPLE_THEME_, entry: SAMPLE_ENTRY_, idiom: SAMPLE_IDIOM_, sample: true };
  } else {
    var items = body.mode === 'day'
      ? [{ id: body.entry.id, kind: 'entry', theme: body.entry.theme }].concat(body.idiom ? [{ id: body.idiom.id, kind: 'idiom', theme: body.idiom.theme }] : [])
      : body.review.entries.map(function (e) { return { id: e.id, kind: 'entry', theme: e.theme }; })
          .concat(body.review.idioms.map(function (i) { return { id: i.id, kind: 'idiom', theme: i.theme }; }));
    markShown_(items, today);
  }
  var doneDays = practiceDays_();
  body.date = today;
  body.done = !!doneDays[today];
  body.streak = streak_(doneDays, today);
  body.week = weekFlags_(doneDays, today);
  body.tts_rate = cfg.tts_rate;
  body.saved = body.mode === 'day' ? {
    word: !!saved[body.entry.id + ':word'],
    phrase: !!saved[body.entry.id + ':phrase'],
    idiom: !!(body.idiom && saved[body.idiom.id + ':idiom'])
  } : {};
  return body;
}

/** Records items as seen today. → how many were seen for the first time. */
function markShown_(items, date) {
  if (!items.length) return 0;
  var lock = LockService.getScriptLock();
  lock.waitLock(5000);
  try {
    var sh = sheet_('Shown'), rows = sh.getDataRange().getValues(), at = {}, fresh = 0;
    rows.forEach(function (r, i) { if (i && r[0]) at[String(r[0])] = i + 1; });
    items.forEach(function (it) {
      var row = at[it.id], prev = row ? rows[row - 1].map(function (v, j) { return j >= 3 && j <= 4 ? cellDate_(v) : v; }) : null;
      var res = shownRow_(prev, it, date);
      if (!res.changed) return;
      if (res.isNew) { writeRow_(sh, 0, res.row); fresh++; }
      else writeRow_(sh, row, res.row);
    });
    return fresh;
  } finally {
    lock.releaseLock();
  }
}

/** Adds to today's row in the Practice tab (one row per day). */
function logPractice_(date, patch) {
  var lock = LockService.getScriptLock();
  lock.waitLock(5000);
  try {
    var sh = sheet_('Practice'), row = findRow_(sh, date), prev = null;
    if (row) {
      var v = sh.getRange(row, 1, 1, PRACTICE_COLS_.length).getValues()[0];
      prev = {};
      PRACTICE_COLS_.forEach(function (c, i) { prev[c] = v[i]; });
    }
    var m = mergePractice_(prev, patch, date, config_().language, nowStamp_());
    var out = PRACTICE_COLS_.map(function (c) { return m[c]; });
    writeRow_(sh, row, out);
  } finally {
    lock.releaseLock();
  }
}

/** Days with a Practice row (finished days) → { 'yyyy-MM-dd': true }. */
function practiceDays_() {
  var set = {};
  sheet_('Practice').getDataRange().getValues().slice(1).forEach(function (r) { if (r[0]) set[cellDate_(r[0])] = true; });
  return set;
}

/** Of these Shown ids, how many were seen for the first time on `date`. */
function firstSeenOn_(ids, date) {
  var want = {}, n = 0;
  ids.forEach(function (id) { if (id) want[id] = true; });
  sheet_('Shown').getDataRange().getValues().slice(1).forEach(function (r) {
    if (want[String(r[0])] && cellDate_(r[3]) === date) n++;
  });
  return n;
}

/**
 * API: the day is finished. Writes (or adds to) today's Practice row, the one
 * VERA reads, and returns the new streak.
 *   p = { mode: 'day'|'review', minutes, entry_id, idiom_id, theme, note,
 *         spoken: [{ target, heard }]   (day: the lines said with the mic)
 *         ratings: { id: 'knew'|'unsure'|'no' } }   (review)
 */
function apiComplete_(p) {
  p = p || {};
  var today = Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd');
  var rated = p.mode === 'review' ? applyRatings_(p.ratings || {}, today) : 0;
  logPractice_(today, {
    minutes: sessionMinutes_(p.minutes), sessions: 1,
    new_items: p.mode === 'review' ? 0 : firstSeenOn_([p.entry_id, p.idiom_id], today),
    reviewed: rated,
    theme: String(p.theme || '').slice(0, 80), note: String(p.note || '').slice(0, 160),
    speaking: p.mode === 'review' ? '' : speakingOfDay_((p.spoken || []).slice(0, 8))
  });
  if (p.mode === 'review') { try { updateReadiness_(); } catch (e) { Logger.log('updateReadiness_: ' + e); } }
  var doneDays = practiceDays_();
  return { done: true, streak: streak_(doneDays, today), week: weekFlags_(doneDays, today) };
}

/** API: Réglages › Recalculer. */
function apiRerunWeek_() {
  rerunThisWeek();
  return todayPayload_();
}

// ======================= Progress.js =======================
// ============================================================
// ÉLISE — Progress.js
// Level and progress, all in the backend (the Sheet's Config tab shows them):
//
//   Spaced review   Sunday's review is a self-test: each item is rated
//                   knew / unsure / no. Items live in 5 boxes, reviewed after
//                   1, 2, 4, 8, 16 weeks; knew moves up a box, unsure stays,
//                   no goes back to box 1. Box 4–5 = mastered. Due items come
//                   back in Sunday's review next to the week's own.
//   Speaking        each line said with the mic is compared with its target
//                   (0–100); the day's average goes to Practice › speaking.
//   Readiness       every Sunday night and after each review, the evidence for
//                   the next level is checked and written to Config:
//                   level_readiness (the numbers), level_suggestion (only when
//                   ready). ÉLISE never changes `level` itself: you do, in Config.
//
// Everything above the "Apps Script" line is pure (tests/progress.test.js).
// ============================================================

var LEITNER_WEEKS_ = [0, 1, 2, 4, 8, 16];   // index = box (1–5)
var MASTERED_BOX_ = 4;
var REVIEW_DUE_LIMIT_ = 6;
var RATINGS_ = ['knew', 'unsure', 'no'];

// What a level shows in a week (Mon–Sat), and what a theme needs to run it
// twice (so a repeat year still has unseen entries).
var MIX_BY_LEVEL_ = {
  B1: [['B1', 4], ['B2', 1], ['argot', 1]],
  B2: [['B1', 2], ['B2', 3], ['argot', 1]]
};
var REQUIRED_BY_LEVEL_ = {
  B1: { B1: 6, B2: 2, argot: 2 },
  B2: { B1: 4, B2: 6, argot: 2 }
};

// The evidence for moving up. Thresholds are a first guess, to tune on real data.
var LEVEL_RULES_ = {
  B1: { next: 'B2', weeks: 8, daysPerWeek: 4, recall: { B1: { rate: 0.85, min: 30 }, B2: { rate: 0.70, min: 10 } }, speaking: { avg: 70, min: 10 } },
  B2: { next: 'C1', weeks: 12, daysPerWeek: 4, recall: { B2: { rate: 0.85, min: 40 } }, speaking: { avg: 80, min: 15 } }
};
var READINESS_WINDOW_DAYS_ = 56;

// ---- pure ------------------------------------------------------------------------

function mixFor_(level) { return MIX_BY_LEVEL_[level] || MIX_BY_LEVEL_.B1; }
function requiredFor_(level) { return REQUIRED_BY_LEVEL_[level] || REQUIRED_BY_LEVEL_.B1; }

/** Pure: an item's spaced-review state after a rating on `date`. prev = { box, reviews, knew } or null. */
function leitnerNext_(prev, rating, date) {
  prev = prev || {};
  var box = Math.max(1, Math.min(5, Number(prev.box) || 1));
  if (rating === 'knew') box = Math.min(5, box + 1);
  else if (rating === 'no') box = 1;
  return {
    box: box, due: enShift_(date, 7 * LEITNER_WEEKS_[box]), last_rating: rating, last_review: date,
    reviews: (Number(prev.reviews) || 0) + 1, knew: (Number(prev.knew) || 0) + (rating === 'knew' ? 1 : 0)
  };
}

/** Pure: ids due for review on `date` (oldest due first), skipping `exclude`, at most `limit`. shown = { id: { due } }. */
function dueItems_(shown, date, exclude, limit) {
  exclude = exclude || {};
  return Object.keys(shown || {})
    .filter(function (id) { var d = shown[id].due; return d && d <= date && !exclude[id]; })
    .sort(function (a, b) { var x = shown[a].due, y = shown[b].due; return x < y ? -1 : x > y ? 1 : (a < b ? -1 : 1); })
    .slice(0, limit);
}

/** Pure: French text → lower-case words without accents or punctuation. */
function words_(s) {
  return enNorm_(s).replace(/[^a-z0-9' ]+/g, ' ').replace(/'/g, ' ').split(/\s+/).filter(Boolean);
}

/** Pure: how much of the target line was heard (0–100): the share of its words found in what was heard. */
function speakScore_(heard, target) {
  var want = words_(target), got = words_(heard), pool = {};
  if (!want.length) return 0;
  got.forEach(function (w) { pool[w] = (pool[w] || 0) + 1; });
  var hit = 0;
  want.forEach(function (w) { if (pool[w]) { pool[w]--; hit++; } });
  return Math.round(100 * hit / want.length);
}

/** Pure: the average score of a day's spoken lines → number, or '' when none. */
function speakingOfDay_(spoken) {
  var s = (spoken || []).filter(function (x) { return x && x.target; }).map(function (x) { return speakScore_(x.heard, x.target); });
  return s.length ? Math.round(s.reduce(function (a, b) { return a + b; }, 0) / s.length) : '';
}

/**
 * Pure: is the evidence there for the next level?
 *   o = { level, since: 'yyyy-MM-dd', today,
 *         items: [{ level, reviews, knew, last_review, box }],   (entries you have reviewed)
 *         practice: [{ date, speaking }] }                       (finished days)
 * → { level, next, ready, checks: [{ key, label, value, target, ok, skipped }], mastered, summary }
 */
function readiness_(o) {
  var rule = LEVEL_RULES_[o.level];
  var from = enShift_(o.today, -READINESS_WINDOW_DAYS_);
  var mastered = (o.items || []).filter(function (x) { return Number(x.box) >= MASTERED_BOX_; }).length;
  if (!rule) return { level: o.level, next: '', ready: false, checks: [], mastered: mastered, summary: o.level + ' : pas de niveau suivant pour l’instant' };
  var checks = [];
  var weeks = Math.floor((enParse_(o.today) - enParse_(o.since || o.today)) / 864e5 / 7);
  checks.push({ key: 'weeks', label: 'semaines au niveau', value: weeks, target: rule.weeks, ok: weeks >= rule.weeks });

  var days = (o.practice || []).filter(function (p) { return p.date >= from && p.date <= o.today; });
  var perWeek = Math.round(10 * days.length / (READINESS_WINDOW_DAYS_ / 7)) / 10;
  checks.push({ key: 'days', label: 'jours/semaine', value: perWeek, target: rule.daysPerWeek, ok: perWeek >= rule.daysPerWeek });

  Object.keys(rule.recall).forEach(function (lv) {
    var r = rule.recall[lv];
    var its = (o.items || []).filter(function (x) { return x.level === lv && x.last_review && x.last_review >= from; });
    var n = its.reduce(function (a, x) { return a + (Number(x.reviews) || 0); }, 0);
    var k = its.reduce(function (a, x) { return a + (Number(x.knew) || 0); }, 0);
    var rate = n ? k / n : 0;
    checks.push({ key: 'recall_' + lv, label: 'rappel ' + lv, value: n ? Math.round(100 * rate) : null, target: Math.round(100 * r.rate),
                  ok: n >= r.min && rate >= r.rate, note: n < r.min ? n + '/' + r.min + ' révisions' : '' });
  });

  var sp = days.filter(function (p) { return p.speaking !== '' && p.speaking != null && !isNaN(Number(p.speaking)); }).map(function (p) { return Number(p.speaking); });
  if (!sp.length) {
    checks.push({ key: 'speaking', label: 'oral', value: null, target: rule.speaking.avg, ok: true, skipped: true, note: 'non mesuré' });
  } else {
    var avg = Math.round(sp.reduce(function (a, b) { return a + b; }, 0) / sp.length);
    checks.push({ key: 'speaking', label: 'oral', value: avg, target: rule.speaking.avg, ok: sp.length >= rule.speaking.min && avg >= rule.speaking.avg,
                  note: sp.length < rule.speaking.min ? sp.length + '/' + rule.speaking.min + ' jours' : '' });
  }

  var ready = checks.every(function (c) { return c.ok; });
  var okCount = checks.filter(function (c) { return c.ok && !c.skipped; }).length, total = checks.filter(function (c) { return !c.skipped; }).length;
  var parts = checks.map(function (c) {
    var v = c.value == null ? '—' : c.value + (c.key.indexOf('recall') === 0 || c.key === 'speaking' ? ' %' : '');
    var t = c.target + (c.key.indexOf('recall') === 0 || c.key === 'speaking' ? ' %' : '');
    return c.label + ' ' + v + ' / ' + t + (c.skipped ? ' (' + c.note + ')' : c.ok ? ' ✓' : c.note ? ' (' + c.note + ')' : '');
  });
  return {
    level: o.level, next: rule.next, ready: ready, checks: checks, mastered: mastered,
    summary: o.level + ' → ' + rule.next + ' : ' + okCount + '/' + total + ' critères · ' + parts.join(' · ') + ' · ' + mastered + ' mots maîtrisés'
  };
}

// ---- Apps Script -------------------------------------------------------------------

/** Applies Sunday's ratings ({ id: 'knew'|'unsure'|'no' }) to the Shown rows. → how many were rated. */
function applyRatings_(ratings, date) {
  var ids = Object.keys(ratings || {}).filter(function (id) { return RATINGS_.indexOf(ratings[id]) !== -1; });
  if (!ids.length) return 0;
  var lock = LockService.getScriptLock();
  lock.waitLock(5000);
  try {
    var sh = sheet_('Shown'), rows = sh.getDataRange().getValues(), n = 0;
    rows.forEach(function (r, i) {
      var id = String(r[0]);
      if (!i || !ratings[id] || RATINGS_.indexOf(ratings[id]) === -1) return;
      var s = leitnerNext_({ box: r[6], reviews: r[10], knew: r[11] }, ratings[id], date);
      var row = r.slice(0, 6).map(function (v, j) { return j >= 3 && j <= 4 ? cellDate_(v) : v; })
        .concat([s.box, s.due, s.last_rating, s.last_review, s.reviews, s.knew]);
      writeRow_(sh, i + 1, row);
      n++;
    });
    return n;
  } finally {
    lock.releaseLock();
  }
}

/** Checks the evidence for the next level and writes it to Config (level_readiness, level_suggestion). */
function updateReadiness_() {
  var today = Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd');
  var raw = readConfig_(), level = raw.level || 'B1';
  if (raw.level_seen !== level || !raw.level_since) {   // a new level (or first run): the clock starts now
    writeConfig_('level_since', raw.level_seen && raw.level_seen !== level ? today : (raw.level_since || firstPracticeDay_() || today));
    writeConfig_('level_seen', level);
    raw = readConfig_();
  }
  var lib = readLibrary_(), levelOf = {};
  lib.entries.forEach(function (e) { levelOf[e.id] = e.level; });
  var items = [];
  sheet_('Shown').getDataRange().getValues().slice(1).forEach(function (r) {
    if (r[0] && String(r[1]) === 'entry' && r[9]) {
      items.push({ level: levelOf[String(r[0])] || '', box: r[6], last_review: cellDate_(r[9]), reviews: r[10], knew: r[11] });
    }
  });
  var practice = sheet_('Practice').getDataRange().getValues().slice(1).filter(function (r) { return r[0]; })
    .map(function (r) { return { date: cellDate_(r[0]), speaking: r[9] }; });
  var res = readiness_({ level: level, since: cellDate_(raw.level_since), today: today, items: items, practice: practice });
  writeConfig_('level_readiness', res.summary + ' (' + today + ')');
  writeConfig_('level_suggestion', res.ready
    ? 'Prêt pour ' + res.next + ' ? Vérifiez avec un test blanc (TCF ou DELF ' + res.next + '), puis remplacez « level » par ' + res.next + '.'
    : '');
  return res;
}

function firstPracticeDay_() {
  var d = '';
  sheet_('Practice').getDataRange().getValues().slice(1).forEach(function (r) { var x = r[0] ? cellDate_(r[0]) : ''; if (x && (!d || x < d)) d = x; });
  return d;
}
